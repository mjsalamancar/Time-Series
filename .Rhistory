library(MASS)
library(ggplot2)
# 1. Definir los parámetros
mu_X <- 170
mu_Y <- 70
sigma_X <- 10
sigma_Y <- 5
rho <- 0.7
# Vector de Medias (\mu_{X,Y})
mu <- c(mu_X, mu_Y)
# Matriz de Covarianza (\Sigma_{XY})
cov_XY <- rho * sigma_X * sigma_Y
Sigma <- matrix(c(sigma_X^2, cov_XY,
cov_XY,     sigma_Y^2),
nrow = 2, ncol = 2)
# 2. Generar 1,000 observaciones
set.seed(42)
datos <- as.data.frame(mvrnorm(n = 1000, mu = mu, Sigma = Sigma))
colnames(datos) <- c("X", "Y")
# 3. Graficar
ggplot(datos, aes(x = X, y = Y)) +
geom_point(alpha = 0.3, color = "steelblue") +
geom_density_2d(color = "firebrick") +
labs(title = "Distribución Normal Bivariada (NMV2)",
x = "Variable X", y = "Variable Y") +
theme_minimal()
reticulate::repl_python()
reticulate::repl_python()
reticulate::repl_python()
reticulate::repl_python()
reticulate::repl_python()
reticulate::repl_python()
#| echo: false
# 1. Instalar paquetes necesarios si no los tienes
if(!require(MASS)) install.packages("MASS")
if(!require(ggplot2)) install.packages("ggplot2")
# Instalar paquetes si no los tienes
if(!require(plotly)) install.packages("plotly")
library(plotly)
# 1. Definir parámetros de la Normal Bivariada (NMV2)
mu_X <- 0
mu_Y <- 0
sigma_X <- 1
sigma_Y <- 1
rho <- 0.7  # Correlación
# 2. Crear la malla de puntos (Grid)
x <- seq(-3, 3, length.out = 100)
y <- seq(-3, 3, length.out = 100)
# 3. Calcular la densidad de probabilidad Z
f_z <- function(x, y) {
term1 <- 1 / (2 * pi * sigma_X * sigma_Y * sqrt(1 - rho^2))
term2 <- -1 / (2 * (1 - rho^2))
term3 <- (x^2 / sigma_X^2) - (2 * rho * x * y / (sigma_X * sigma_Y)) + (y^2 / sigma_Y^2)
return(term1 * exp(term2 * term3))
}
Z <- outer(x, y, f_z)
# 4. Generar la gráfica 3D interactiva
plot_ly(x = ~x, y = ~y, z = ~Z) %>%
add_surface(colorscale = "Viridis") %>%
layout(
title = paste("Densidad Normal Bivariada (ρ =", rho, ")"),
scene = list(
xaxis = list(title = "Variable X"),
yaxis = list(title = "Variable Y"),
zaxis = list(title = "Densidad Z")
)
)
